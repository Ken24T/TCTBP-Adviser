{
  "schemaVersion": 11,
  "adviserContract": {
    "major": 1,
    "minor": 0,
    "capabilities": [
      "inspection.local-v1",
      "workflow-catalogue.core-v1",
      "reason-codes.core-v1"
    ],
    "schema": "schemas/tctbp-adviser-inspection-v1.schema.json",
    "compatibility": "Readers reject unsupported major versions, ignore unknown additive fields, and degrade by missing capability."
  },
  "adviserVocabulary": {
    "reasonCodes": [
      "active-git-operation",
      "detached-head",
      "branch-diverged",
      "working-tree-dirty-and-behind",
      "working-tree-dirty",
      "branch-behind",
      "branch-unpublished",
      "branch-ahead",
      "ship-ready",
      "handover-ready",
      "no-action-required",
      "inspection-required",
      "status-inspection-failed"
    ],
    "guardrailIds": [
      "git.operation.active",
      "git.head.detached",
      "git.branch.diverged",
      "git.working-tree.dirty-behind",
      "git.working-tree.dirty",
      "git.branch.behind",
      "git.branch.unpublished",
      "git.branch.ahead"
    ],
    "workflowIds": [
      "status",
      "abort",
      "resume",
      "checkpoint",
      "publish",
      "handover",
      "branch",
      "promote",
      "deploy",
      "ship",
      "hotfix"
    ]
  },
  "governance": {
    "sourceOfTruth": "TCTBP.json",
    "fallbackDocument": "TCTBP Agent.md",
    "templateMode": false,
    "templateInstructions": "This profile was generated by TCTBP-Web scaffold for tctbp-adviser. Update commands and deploy targets as the project grows."
  },
  "project": {
    "name": "tctbp-adviser",
    "description": "A local-first, read-only adviser that explains repository state and recommends safe TCTBP workflows.",
    "defaultBranch": "main",
    "packageManager": "npm",
    "versionFiles": [
      "package.json"
    ],
    "changelogFormat": "keep-a-changelog",
    "locale": "en-US"
  },
  "branchModel": {
    "strategy": "long-lived-environment-branches",
    "workingBranch": "development",
    "reviewBranch": "review",
    "productionBranch": "main",
    "promoteEnabled": true,
    "deployEnabled": true
  },
  "profile": {
    "runtimeCwd": ".",
    "commands": {
      "format": null,
      "test": "npm run test",
      "lint": null,
      "build": "npm run build",
      "releaseBuild": null
    },
    "qualityGates": {
      "requireZeroProblems": true,
      "requireTestsBeforeShip": true,
      "requireLintBeforeShip": false,
      "requireBuildBeforeShip": true
    },
    "versioning": {
      "sourceOfTruth": "package.json",
      "tagFormat": "v{version}",
      "formatAfterBump": false
    },
    "devServer": {
      "port": 3037,
      "label": "Vite development server"
    },
    "developmentPolicy": {
      "maxFileLines": {
        "softCeiling": 250,
        "warningThreshold": 400,
        "hardSplit": 600,
        "comment": "AI agents and contributors should respect these file-size limits. Files at or above hardSplit must be split before checkpoint. Files above warningThreshold require a justification comment at the top."
      },
      "modularity": {
        "preferModularFiles": true,
        "extractAtFunctionGroupSize": 3,
        "maxImportsPerModule": 8,
        "comment": "Prefer many small single-purpose files over large multi-purpose files. Extract a group of 3+ related functions into a dedicated module. Consider splitting a module when importing more than 8 symbols from it."
      },
      "functionRules": {
        "maxLines": 40,
        "preferPure": true,
        "noAnyInExportedSignatures": true,
        "comment": "Keep functions small and focused. Prefer pure functions. Avoid 'any' in exported TypeScript signatures."
      }
    }
  },
  "activation": {
    "triggers": [
      "ship",
      "ship please",
      "shipping",
      "prepare release",
      "checkpoint",
      "checkpoint please",
      "publish",
      "publish please",
      "promote",
      "promote please",
      "promote staging",
      "promote staging please",
      "promote review",
      "promote review please",
      "promote production",
      "promote production please",
      "promote prod",
      "promote prod please",
      "deploy",
      "deploy please",
      "deploy dev",
      "deploy dev please",
      "deploy development",
      "deploy development please",
      "deploy staging",
      "deploy staging please",
      "deploy review",
      "deploy review please",
      "deploy prod",
      "deploy prod please",
      "deploy production",
      "deploy production please",
      "handover",
      "handover please",
      "handover local",
      "handover local please",
      "resume",
      "resume please",
      "orient",
      "orient please",
      "status",
      "status please",
      "abort",
      "run tests",
      "run lint",
      "run build",
      "gate test",
      "gate lint",
      "gate build",
      "ticket create",
      "ticket report",
      "ticket triage",
      "version status",
      "version check",
      "rollback",
      "revert last checkpoint",
      "hotfix",
      "hotfix please",
      "hotfix start",
      "hotfix start please",
      "hotfix finish",
      "hotfix finish please",
      "emergency fix",
      "emergency fix please"
    ],
    "caseInsensitive": true
  },
  "promote": {
    "enabled": true,
    "preferredTriggers": [
      "promote",
      "promote please",
      "promote review",
      "promote review please",
      "promote production",
      "promote production please"
    ],
    "executionCommand": "node scripts/tctbp-run-promote.js <review|production> --no-docs-impact \"<reason>\"",
    "purpose": "Explicitly merge the current source branch into the target environment branch with verification gates, safety snapshots, and a mandatory merge deletion audit. Promotion is a merge workflow, not a deploy workflow.",
    "targets": {
      "review": {
        "sourceBranch": "development",
        "targetBranch": "review",
        "description": "Promote the current development candidate into review for field testing.",
        "allowDirtySourceSync": true,
        "publishSourceWhenNeeded": true,
        "allowFirstSourcePublish": true,
        "requireCleanTargetBeforeMerge": true,
        "allowTargetFastForwardFromOrigin": true,
        "publishTargetAfterPromotion": true,
        "allowFirstTargetPublish": true,
        "returnToSourceBranchAfterPromotion": true,
        "stopIfVerificationOrBuildChangesWorkingTree": true,
        "defaultSourceSyncCommitMessage": "chore(promote): sync development before review promotion",
        "defaultMergeCommitMessage": "chore(review): promote development to review",
        "postPromotionValidation": [
          "Confirm origin/review now contains the promoted review candidate.",
          "Confirm the review environment can pick up the updated review branch state."
        ],
        "comment": "Use when the current development candidate should become the field-testing review candidate."
      },
      "production": {
        "sourceBranch": "review",
        "targetBranch": "main",
        "description": "Promote the current review candidate into main as the next production release candidate.",
        "allowDirtySourceSync": false,
        "publishSourceWhenNeeded": true,
        "allowFirstSourcePublish": true,
        "requireCleanTargetBeforeMerge": true,
        "allowTargetFastForwardFromOrigin": true,
        "publishTargetAfterPromotion": false,
        "returnToSourceBranchAfterPromotion": false,
        "requireShipAfterPromotion": true,
        "stopIfVerificationOrBuildChangesWorkingTree": true,
        "defaultMergeCommitMessage": "chore(main): promote review to main",
        "postPromotionValidation": [
          "Confirm local main now contains the promoted production candidate from review.",
          "Confirm main is ready for SHIP from a clean local branch.",
          "Confirm no push or deployment occurred as part of promote production."
        ],
        "comment": "Use when the current review candidate should become the next production release candidate on main, but keep SHIP and production deploy as separate explicit workflows."
      }
    }
  },
  "deploy": {
    "enabled": false,
    "targets": {}
  },
  "codeLossPrevention": {
    "enabled": true,
    "safetyTagsEnabled": true,
    "safetyTagFormat": "safety/<branch-name>-<YYYYMMDD>",
    "safetyTagsLocalOnlyByDefault": true,
    "mergeDeletionAudit": {
      "enabled": true,
      "warnThreshold": {
        "files": 1,
        "lines": 500
      },
      "stopThreshold": {
        "files": 5,
        "lines": 500
      },
      "hardStopThreshold": {
        "files": 20,
        "lines": 2000
      },
      "stopMessage": "This merge deletes {files} files ({lines} lines). Type 'confirm deletions' to proceed.",
      "hardStopMessage": "This looks like a destructive tree reset, not a normal merge. Review carefully before proceeding."
    },
    "prePushNetDeletionCheck": {
      "enabled": true,
      "mode": "warn",
      "message": "This push has a net deletion of {net} lines ({added} added, {removed} removed). Confirm this is intentional."
    },
    "comment": "Code-loss prevention gates apply to branch closeout merges, promote merges, and any agent-performed merge into a default or environment branch."
  },
  "versioning": {
    "scheme": "semver",
    "patchEveryShip": true,
    "patchEveryShipForDocsInfrastructureOnly": true,
    "minorOnFirstShipOfBranch": true,
    "minorBranchPrefixes": [
      "slice/",
      "feature/"
    ],
    "majorExplicitOnly": true
  },
  "tagging": {
    "policy": "everyCommit",
    "skipWhenNoBump": true,
    "format": "v{version}"
  },
  "candidateGuard": {
    "enabled": true,
    "defaultRemote": "origin",
    "requireFullGitObjectIds": true,
    "comment": "Promotion and release workflows should bind candidates to both commit and tree identities and revalidate them at approval boundaries."
  },
  "promotionSafety": {
    "enabled": true,
    "inspectMergePreflight": true,
    "inspectDeletionImpact": true,
    "mergeDeleteAudit": {
      "warnThresholdFiles": 5,
      "warnThresholdLines": 500,
      "hardStopThresholdFiles": 20,
      "hardStopThresholdLines": 2000
    },
    "comment": "Use read-only merge preflight and deletion impact checks before a mutating promotion merge."
  },
  "releaseState": {
    "enabled": true,
    "path": ".tctbp-runtime/release-state.json",
    "kind": "tctbp-release-state",
    "atomicWrites": true,
    "journalPermissions": "0600",
    "stageOrder": [
      "preflight-gates",
      "development-deployed",
      "staging-promoted",
      "staging-deployed",
      "production-promoted",
      "shipped",
      "production-deployed",
      "finalized"
    ],
    "candidateStages": {
      "development": {
        "stage": "preflight-gates",
        "evidenceKey": "developmentCandidate",
        "branch": "development"
      },
      "staging": {
        "stage": "staging-promoted",
        "evidenceKey": "stagingCandidate",
        "branch": "staging"
      },
      "production": {
        "stage": "production-promoted",
        "evidenceKey": "productionCandidate",
        "branch": "main"
      }
    },
    "comment": "Release journals are generic workflow evidence. Project-specific backup and restore stages must be added by downstream profiles rather than assumed by TCTBP-Web."
  },
  "runtimeTransaction": {
    "enabled": true,
    "entrypoint": null,
    "requireServiceHooks": true,
    "preserveFailedCandidate": true,
    "comment": "Runtime publication is an injectable atomic bundle transaction. Service lifecycle and health verification belong to the consuming project."
  }
}
