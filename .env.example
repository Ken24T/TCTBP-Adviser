# JSON arrays keep paths unambiguous across Linux and Windows.
TCTBP_ADVISER_REPOSITORY_ROOTS=["/home/ken/Documents/development/repos"]
# Optional local checkout used as the canonical TCTBP-Web upgrade source.
# TCTBP_ADVISER_TCTBP_WEB_ROOT=/absolute/path/to/TCTBP-Web
TCTBP_ADVISER_EXCLUDE_DIRECTORIES=["node_modules",".git","dist","build","archive",".cache"]

# Bounded local discovery and inspection.
TCTBP_ADVISER_MAXIMUM_DEPTH=3
TCTBP_ADVISER_MAXIMUM_DIRECTORIES=5000
TCTBP_ADVISER_MAXIMUM_REPOSITORIES=200
TCTBP_ADVISER_INSPECTION_CONCURRENCY=4
TCTBP_ADVISER_CACHE_TTL_MS=30000

# Optional encrypted Jasper AI review settings. Disabled unless explicitly enabled.
# TCTBP_ADVISER_AI_SETTINGS_FILE=/home/ken/.config/tctbp-adviser/ai-settings.json
# TCTBP_ADVISER_AI_KEY_FILE=/home/ken/.config/tctbp-adviser/ai-settings.key
# TCTBP_ADVISER_AI_ENABLED=false
# TCTBP_ADVISER_AI_BASE_URL=https://provider.example/v1
# TCTBP_ADVISER_AI_MODEL=your-model

# Optional, read-only GitHub provider enrichment. Public repositories need no
# token. Keep tokens server-side; they are never sent to the browser.
TCTBP_ADVISER_GITHUB_ENABLED=false
TCTBP_ADVISER_GITHUB_REPOSITORIES=[]
# TCTBP_ADVISER_GITHUB_TOKEN=
TCTBP_ADVISER_GITHUB_TIMEOUT_MS=5000
TCTBP_ADVISER_GITHUB_MAX_RESPONSE_BYTES=2097152
TCTBP_ADVISER_GITHUB_CACHE_TTL_MS=60000
TCTBP_ADVISER_GITHUB_CONCURRENCY=3
