# JSON arrays keep paths unambiguous across Linux and Windows.
TCTBP_ADVISER_REPOSITORY_ROOTS=["/home/ken/Documents/development/repos"]
TCTBP_ADVISER_EXCLUDE_DIRECTORIES=["node_modules",".git","dist","build","archive",".cache"]

# Bounded local discovery and inspection.
TCTBP_ADVISER_MAXIMUM_DEPTH=3
TCTBP_ADVISER_MAXIMUM_DIRECTORIES=5000
TCTBP_ADVISER_MAXIMUM_REPOSITORIES=200
TCTBP_ADVISER_INSPECTION_CONCURRENCY=4
TCTBP_ADVISER_CACHE_TTL_MS=30000
