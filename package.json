{
  "name": "tctbp-adviser",
  "private": true,
  "version": "0.1.0",
  "description": "A web application built with the TCTBP-Web workflow.",
  "scripts": {
    "dev": "vite --mode development --host 127.0.0.1 --port 3037 --strictPort",
    "review": "vite --mode review --host 127.0.0.1 --port 4037 --strictPort",
    "start": "npm run preview",
    "build": "tsc -b && vite build",
    "preview": "vite preview --mode production --host 127.0.0.1 --port 5037 --strictPort",
    "production": "npm run build && npm run preview",
    "ai:settings": "node scripts/tctbp-ai-settings.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^1.0.0"
  }
}
